# Required for normal startup. Manage keys: https://platform.openai.com/home
# Read only for configuration checks; never exported to MCP/worker child tasks.
CONTROL_PLANE_API_KEY=
TUNNEL_ID=
# OPENAI_API_KEY is not required: this runtime does not call a model API.

# Same runtime settings for MCP and worker.
REMOTE_HOST=127.0.0.1
REMOTE_PORT=8200
# Set these absolute paths for your machine before starting both services.
REMOTE_ROOT=/home/YOUR_USER
REMOTE_STATE_DIR=/home/YOUR_USER/.local/state/better-gptchat
REMOTE_TASK_SCOPE=local-owner
REMOTE_WORKER_CONCURRENCY=4
REMOTE_MAX_OUTPUT_CHARS=100000

# Tunnel service (key and ID above are used only by tunnel-client).
# Omit binary paths to search PATH, then the local installed binary directory.
# TUNNEL_CLIENT_BIN=/absolute/path/to/tunnel-client
# CLOUDFLARED_BIN=/absolute/path/to/cloudflared
TUNNEL_ADMIN_PORT=8280
# Optional outbound proxy; NO_PROXY always includes the local MCP endpoint.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# Optional control-plane-only proxy:
# TUNNEL_HTTP_PROXY=http://127.0.0.1:7890
